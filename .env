# .env
# Environment variables for the React app.
# These are loaded by React during build and development (via CRA).
# All variables MUST start with "REACT_APP_" to be accessible in code.

# MTConnect Agent Host & Port (used in setupProxy.js and API calls)
# Replace with your MTConnect server IP and port
REACT_APP_MTCONNECT_HOST=10.83.70.180
REACT_APP_MTCONNECT_PORT=5000

# Polling interval for API calls (in milliseconds)
REACT_APP_API_POLLING_IN_MS=5000
